# --- raw: ignore every subfolder's contents, keep .gitkeep (README.md & raw/.gitkeep untouched) ---
raw/*/**
!raw/*/**/
!raw/*/**/.gitkeep

# --- local/processed: ignore contents, keep .gitkeep ---
local/processed/**
!local/processed/**/
!local/processed/**/.gitkeep

# --- recai/processed: ignore contents, keep .gitkeep ---
recai/processed/**
!recai/processed/**/
!recai/processed/**/.gitkeep

# local/log and recai/log are intentionally NOT listed — stay fully tracked