# Copy file này thành .env và chỉnh lại giá trị nếu cần
# Không commit file .env thật lên git

# --- Browser ---
HEADLESS=true
WINDOW_WIDTH=1920
WINDOW_HEIGHT=1080
PAGE_LOAD_TIMEOUT=30
PRODUCT_TIMEOUT=20

# --- Crawl limits ---
MAX_PAGES_PER_KEYWORD=20
MAX_PRODUCTS=1000
MAX_RETRIES=3

# --- Rate limiting (giây) ---
MIN_DELAY=1.5
MAX_DELAY=4.0

# --- Storage ---
SAVE_RAW_HTML=false
OUTPUT_DIR=data/processed

# --- Base URL ---
BASE_URL=https://shopee.vn
