.*
!.gitignore
!.gitmodules


# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual environments and local Python build artifacts
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example
build/
dist/
*.egg-info/
.eggs/
*.egg

# Local datasets and pipeline outputs (large and reproducible)
/data/*
!/data/.gitkeep

# Jupyter checkpoints
.ipynb_checkpoints/

# Editor and operating-system files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Local logs are ignored by default, except experiment logs that document runs.
*.log
!experiments/
!experiments/**/*.log

# Secrets and local credentials
*.pem
*.key
credentials.json
secrets.json
