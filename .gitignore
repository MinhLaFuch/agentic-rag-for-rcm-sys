# Local credentials, editor settings and agent indexes.
# Do not ignore all dotfiles: .github workflows and .gitattributes belong in Git.
.env
.env.*
!.env.example
!.env.template
.aws/
.codex/
.agents/
.claude/
.gitnexus/
.vscode/
.idea/
.mcp.json
.DS_Store
Thumbs.db

# Python environments, caches and generated package metadata.
.venv*/
/src/.venv*/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/

# Pipeline inputs, splits, mappings, corpus, model caches and local archives.
# Keep config/history snapshots under src/configs versioned.
/resource/
/src/resource/
/src/src.zip
/src/graphify-out/

# Output accidentally created relative to repository root.
/experiments/

# Keep small experiment reports/configs/metrics in src/experiments versioned.
# Bulk checkpoints and full-build artifacts remain local, including their manifests.
/src/experiments/checkpoints/
/src/experiments/**/checkpoints/
/src/experiments/**/_checkpoints/
/src/experiments/*_builds/
/src/experiments/embedding_builds/
/src/experiments/ann_builds/
/src/experiments/bm25_builds/
/src/experiments/rerankers/
/src/experiments/ann_benchmarks/
/src/experiments/ann_diagnostics/
/src/experiments/cold_query_track_b/
/src/experiments/retrieval_matrix/
/src/experiments/ranking_eval/
/src/experiments/**/scratch/
/src/experiments/test_logs/
/src/experiments/logs/

# Raw candidate/trajectory payloads and binary arrays/models under experiments.
# Do not ignore JSON/JSONL globally: source configs and test fixtures may need them.
/src/experiments/**/*.jsonl
/src/experiments/**/*.npy
/src/experiments/**/*.npz
/src/experiments/**/*.parquet
/src/experiments/**/*.sqlite
/src/experiments/**/*.sqlite-*
/src/experiments/**/*.db
/src/experiments/**/*.db-*
/src/experiments/**/*.pt
/src/experiments/**/*.pth
/src/experiments/**/*.safetensors
/src/experiments/**/*.bin
/src/experiments/**/*.log
/src/experiments/**/*.tmp
/src/experiments/**/*.lock
/src/experiments/**/.*.lock

# Bulk binary artifacts under retrieval investigations (corpus DBs, embeddings, big parquet).
# Small scripts, configs, logs and metrics remain versioned.
/src/investigations/**/*.jsonl
/src/investigations/**/cache/
/src/investigations/**/*.npy
/src/investigations/**/*.npz
/src/investigations/**/*.parquet
/src/investigations/**/*.sqlite
/src/investigations/**/*.sqlite-*
/src/investigations/**/*.db
/src/investigations/**/*.db-*
/src/investigations/**/*.pt
/src/investigations/**/*.pth
/src/investigations/**/*.safetensors
/src/investigations/**/*.bin
/src/investigations/**/*.log
/src/investigations/**/*.tmp
/src/investigations/**/*.lock

# Global heavy binary/data formats (defense in depth against accidental placement).
*.npy
*.npz
*.parquet
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-*
*.pt
*.pth
*.safetensors
*.bin
*.faiss
*.index
*.pkl
*.pickle
*.lock
.*.lock
*.log

# Ad-hoc / scratch test scripts at repository root (unit tests live in src/tests/).
/test_*.py
/check_*.py
/scratch/
/src/scratch/

# Crash dumps, editor backups and Windows shell artifacts.
*.dmp
*.stackdump
nul
desktop.ini
*.swp
*.swo
*~
/powershell.cmd
