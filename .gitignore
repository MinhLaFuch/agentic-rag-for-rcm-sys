# Local credentials, editor settings and agent indexes.
# Do not ignore all dotfiles: .github workflows and .gitattributes belong in Git.
.env
.env.*
!.env.example
!.env.template
.aws/
.codex/
.agents/
.claude/
.gitnexus/
.vscode/
.idea/
.mcp.json
.DS_Store
Thumbs.db

# Python environments, caches and generated package metadata.
.venv*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/

# Pipeline inputs, splits, mappings, corpus, model caches and local archives.
# Keep config/history snapshots under src/configs versioned.
/resource/
/src/resource/
/src/src.zip
/src/graphify-out/

# Output accidentally created relative to repository root.
/experiments/

# Keep small experiment reports/configs/metrics in src/experiments versioned.
# Bulk checkpoints and full-build artifacts remain local, including their manifests.
/src/experiments/checkpoints/
/src/experiments/**/checkpoints/
/src/experiments/**/_checkpoints/
/src/experiments/embedding_builds/
/src/experiments/**/scratch/
/src/experiments/test_logs/
/src/experiments/logs/

# Raw candidate/trajectory payloads and binary arrays/models under experiments.
# Do not ignore JSON/JSONL globally: source configs and test fixtures may need them.
/src/experiments/**/*.jsonl
/src/experiments/**/*.npy
/src/experiments/**/*.npz
/src/experiments/**/*.parquet
/src/experiments/**/*.sqlite
/src/experiments/**/*.sqlite-*
/src/experiments/**/*.db
/src/experiments/**/*.db-*
/src/experiments/**/*.pt
/src/experiments/**/*.pth
/src/experiments/**/*.safetensors
/src/experiments/**/*.bin
/src/experiments/**/*.log
/src/experiments/**/*.tmp
/src/experiments/**/*.lock

# Crash dumps and Windows shell artifacts.
*.dmp
*.stackdump
nul
/powershell.cmd
