# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Pipeline data and pipeline/tool logs: everything under paths.* in configs/path/data_paths.yaml (except experiments_dir)
resource/

# Test logs written by tests/run_*.sh / run_*.bat
tests/logs/

# Experiment results (experiments/exp_NNN/{config.yaml,metrics.json,README.md}) are tracked on purpose;
# only stray logs are ignored. Add `experiments/` here if you decide results should not be versioned.
experiments/**/trajectories.jsonl

# Secrets: never commit credentials (configs/agent/llm.yaml reads LLM_API_KEY from the environment)
.env
*.key
